<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>乾隆大藏经图片浏览</title>
  <style>
    html, body {
      height: 100%;
      margin: 0;
      overflow: hidden;
    }

    .container {
      width: 100vw;
      height: 100vh;
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
      background-color: transparent;
      padding: 10px;
      box-shadow: 0 0 0 5px silver;
      box-sizing: border-box;
      touch-action: pan-x pan-y;
      transition: transform 0.3s ease-in-out;
      position: relative;
    }
    
    .loading-indicator {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background-color: rgba(0,0,0,0.7);
      color: white;
      padding: 10px 20px;
      border-radius: 5px;
      display: none;
    }
  </style>
</head>
<body>

<div id="imageContainer" class="container">
  <div id="loadingIndicator" class="loading-indicator">加载中...</div>
</div>

<script>
  function getQueryVariable(variable) {
    const query = window.location.search.substring(1);
    const vars = query.split('&');
    for (let i = 0; i < vars.length; i++) {
      const pair = vars[i].split('=');
      if (pair[0] === variable) return decodeURIComponent(pair[1]);
    }
    return false;
  }

  const startParam = getQueryVariable('start') || '001001';
  const endParam = getQueryVariable('end') || '999999';

  const startVol = startParam.slice(0, 3);
  const startPage = startParam.slice(3, 6);
  const endVol = endParam.slice(0, 3);
  const endPage = endParam.slice(3, 6);

  let currentPage = startPage;
  let currentVol = startVol;
  let zoomed = false;
  let isLoading = false;

  const edgeThreshold = 0.05;
  const container = document.getElementById('imageContainer');
  const loadingIndicator = document.getElementById('loadingIndicator');

  function showLoading() {
    if (isLoading) return;
    isLoading = true;
    loadingIndicator.style.display = 'block';
  }

  function hideLoading() {
    isLoading = false;
    loadingIndicator.style.display = 'none';
  }

function loadImage1(vol, page) {
  return new Promise((resolve, reject) => {
    showLoading();

    // 卷号 vol：保持原样（带前导零，如 "095"）
    // 页码 page：转为自然数（如 "001" → 1）
    const pageNum = parseInt(page, 10);
    if (isNaN(pageNum) || pageNum <= 0) {
      hideLoading();
      return reject(new Error(`Invalid page: ${page}`));
    }

    // 七牛云地址：vol 原样，page 用自然数
    const qiniuUrl = `http://t4dcar0rt.hd-bkt.clouddn.com/${vol}/${pageNum}.png`;
    // 本地地址：同样结构
    const localUrl = `/qldzj/${vol}/${pageNum}.png`;

    const img = new Image();

    img.onload = () => {
      container.style.backgroundImage = `url(${qiniuUrl})`;
      hideLoading();
      resolve();
    };

    img.onerror = () => {
      console.warn(`七牛加载失败，回退到本地: ${localUrl}`);

      const fallbackImg = new Image();
      fallbackImg.onload = () => {
        container.style.backgroundImage = `url(${localUrl})`;
        hideLoading();
        resolve();
      };
      fallbackImg.onerror = (err) => {
        hideLoading();
        console.error(`本地加载也失败: ${localUrl}`, err);
        reject(new Error(`Both Qiniu and local failed for vol=${vol}, page=${pageNum}`));
      };
      fallbackImg.src = localUrl;
    };

    img.src = qiniuUrl;

    // 处理缓存命中（同步加载）
    if (img.complete && img.naturalWidth > 0) {
      container.style.backgroundImage = `url(${qiniuUrl})`;
      hideLoading();
      resolve();
    }
  });
}


  function loadImage(vol, page) {
    return new Promise((resolve, reject) => {
      showLoading();
      
      const img = new Image();
      //const imgUrl = `/qldzj/${vol}/${page}.png`
      // 将逻辑页码（如 "001"）转换为自然数（1）
      const pageNum = parseInt(page, 10); // → 1
      const imgUrl = `/qldzj/${vol}/${pageNum}.png`;
      
      img.onload = () => {
        container.style.backgroundImage = `url(${imgUrl})`;
        hideLoading();
        resolve();
      };
      
      img.onerror = (err) => {
        hideLoading();
        reject(err);
      };
      
      img.src = imgUrl;
      
      if (img.complete) {
        container.style.backgroundImage = `url(${imgUrl})`;
        hideLoading();
        resolve();
      }
    });
  }

async function changeImage(direction) {
  if (zoomed || isLoading) return;

  // 确保使用数字类型
  let currentPageNum = parseInt(currentPage, 10);
  let currentVolNum = parseInt(currentVol, 10);
  let startPageNum = parseInt(startPage, 10);
  let startVolNum = parseInt(startVol, 10);
  let endPageNum = parseInt(endPage, 10);
  let endVolNum = parseInt(endVol, 10);

  let newPage = currentPageNum + direction;
  let newVol = currentVolNum;

  // 处理翻页逻辑
  if (direction > 0) {
    // 向后翻页
    if (newPage >= 999) {
      newPage = 1;
      newVol += 1;
    }
  } else {
    // 向前翻页
    if (newPage < 1) {
      // 如果是第一页的前一页，应该无操作，而不是跳到上一卷
      // 或者根据需求处理：要么无反应，要么跳到上一卷最后一页
      if (currentPageNum === 1) {
        // 已经在第一页，向前翻应该无反应
        return;
      } else {
        newPage = 999;
        newVol -= 1;
      }
    }
  }

  // 格式化为字符串
  newVol = newVol.toString().padStart(3, '0');
  newPage = newPage.toString().padStart(3, '0');

  // 检查边界（使用数字比较）
  if (
    (parseInt(newVol, 10) < startVolNum) ||
    (parseInt(newVol, 10) === startVolNum && parseInt(newPage, 10) < startPageNum) ||
    (parseInt(newVol, 10) > endVolNum) ||
    (parseInt(newVol, 10) === endVolNum && parseInt(newPage, 10) > endPageNum)
  ) {
    return;
  }

  try {
    await loadImage(newVol, newPage);
    currentPage = newPage;
    currentVol = newVol;
  } catch (err) {
    console.error('图片加载失败:', err);
  }
}


  async function changeImage1(direction) {
    if (zoomed || isLoading) return;
    
    let newPage = parseInt(currentPage, 10) + direction;
    let newVol = parseInt(currentVol, 10);

    if (direction > 0) {
      if (newPage >= 999) {
        newPage = 1;
        newVol += 1;
      }
    } else {
      if (newPage <= 1) {
        newPage = 999;
        newVol -= 1;
      }
    }

    newVol = newVol.toString().padStart(3, '0');
    newPage = newPage.toString().padStart(3, '0');

    if (
      (newVol < startVol) || 
      (newVol === startVol && newPage < startPage) ||
      (newVol > endVol) || 
      (newVol === endVol && newPage > endPage)
    ) {
      return;
    }

    try {
      await loadImage(newVol, newPage);
      currentPage = newPage;
      currentVol = newVol;
    } catch (err) {
      console.error('图片加载失败:', err);
    }
  }

  function updateCursor(event) {
    const rect = event.target.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;
    const width = rect.width;
    const height = rect.height;

    const isTopEdge = y < height * edgeThreshold;
    const isBottomEdge = y > height * (1 - edgeThreshold);
    const isLeftEdge = x < width * edgeThreshold;
    const isRightEdge = x > width * (1 - edgeThreshold);

    if (isTopEdge || isBottomEdge || isLeftEdge || isRightEdge) {
      container.style.cursor = 'pointer';
    } else {
      container.style.cursor = 'auto';
    }
  }

  container.addEventListener('mousemove', updateCursor);
  container.addEventListener('mouseleave', () => {
    container.style.cursor = 'auto';
  });

  container.addEventListener('click', (event) => {
    if (isLoading) return;
    
    const rect = event.target.getBoundingClientRect();
    const clickX = event.clientX - rect.left;
    const width = rect.width;

    const isLeftEdge = clickX < width * edgeThreshold;
    const isRightEdge = clickX > width * (1 - edgeThreshold);

    if (isLeftEdge) {
      changeImage(-1);
    } else if (isRightEdge) {
      changeImage(1);
    }
  });

  // 原生双击事件（桌面）
  container.addEventListener('dblclick', handleDoubleClick);

  function handleDoubleClick(event) {
    if (isLoading) return;
    
    if (zoomed) {
      zoomOut();
      return;
    }

    const rect = container.getBoundingClientRect();
    const y = event.clientY - rect.top;
    const height = rect.height;

    const isTopEdge = y < height * 0.05;
    const isBottomEdge = y > height * 0.95;

    if (isTopEdge) {
      zoomToPosition(0, 'top');
    } else if (isBottomEdge) {
      zoomToPosition(0, 'bottom');
    }
  }

  function zoomToPosition(clickX, position) {
    const scale = 2.4;
    let transformOriginY = 'center';

    if (position === 'top') {
      transformOriginY = '11.8%';
    } else if (position === 'bottom') {
      transformOriginY = '80%';
    }

    container.style.transformOrigin = `50% ${transformOriginY}`;
    container.style.transform = `scale(${scale})`;
    container.style.backgroundSize = 'contain';
    container.style.backgroundPosition = 'center';

    zoomed = true;
  }

  function zoomOut() {
    container.style.transformOrigin = 'center';
    container.style.transform = 'scale(1)';
    container.style.backgroundSize = 'contain';
    container.style.backgroundPosition = 'center';

    zoomed = false;
  }

  window.onload = async () => {
    try {
      await loadImage(currentVol, currentPage);
    } catch (err) {
      console.error('初始图片加载失败:', err);
    }
  };
</script>

</body>
</html>
